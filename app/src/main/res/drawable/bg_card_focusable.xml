<?xml version="1.0" encoding="utf-8"?>
<!--
  可聚焦卡片。电视遥控器靠方向键移动焦点，必须有明确的焦点视觉，
  否则用户不知道自己当前选中了哪一项 —— 这是电视应用的硬性体验要求。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_surface_raised" />
            <corners android:radius="16dp" />
            <stroke
                android:width="2dp"
                android:color="@color/stroke_focus" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_surface" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/stroke_subtle" />
        </shape>
    </item>
</selector>
