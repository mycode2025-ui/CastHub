    <string name="action_check_update">检查</string>
    <string name="action_checking">检查中…</string>

    <string name="update_up_to_date_title">已是最新版本</string>
    <string name="update_up_to_date">当前版本 v%1$s 已是最新。</string>
    <string name="update_failed_title">检查更新失败</string>
    <string name="update_available_title">发现新版本 %1$s</string>
    <string name="update_from">当前版本：v%1$s\n新版本：%2$s</string>
    <string name="update_source">版本信息来自 %1$s</string>
    <string name="update_apk_from">安装包来自 %1$s</string>
    <string name="update_apk_size">安装包大小：%1$s</string>
    <string name="update_release_notes">更新说明：</string>
    <string name="update_no_apk">该版本未附安装包，将打开发布页手动下载。</string>
    <!-- 只要有一个数据源没取到，结论就可能是漏判，必须显式告知 -->
    <string name="update_warnings_title">部分数据源未取到，结论可能不完整</string>

    <string name="action_upgrade_now">立即升级</string>
    <string name="action_later">稍后</string>
    <string name="action_ignore_version">忽略此版本</string>
    <string name="action_open_release_page">打开发布页</string>
    <string name="action_install">安装</string>
    <string name="action_go_settings">去设置</string>

    <string name="update_downloading_title">下载中</string>
    <string name="update_downloading">%1$s / %2$s</string>
    <string name="update_downloading_unknown">已下载 %1$s</string>
    <string name="update_download_failed_title">下载失败</string>
    <string name="update_download_failed_hint">可以打开发布页，用浏览器手动下载安装包。</string>
    <string name="update_no_installer">系统没有可用的安装程序，请打开发布页手动下载。</string>
    <string name="update_no_browser">没有可打开链接的应用。发布页地址：\n%1$s</string>

    <!--
      签名校验是升级流程里唯一的安全关口，因此失败说明必须写清"这意味着什么"，
      而不是一句"校验失败" —— 用户很可能直接去手动装那个包。
    -->
    <string name="update_verify_failed_title">安装包校验未通过</string>
    <string name="update_verify_mismatch">下载到的安装包签名与本机不一致，已中止安装。\n\n本机签名：%1$s\n安装包签名：%2$s\n\n这说明该安装包不是本应用的官方构建，请不要手动安装它。</string>
    <string name="update_verify_unreadable">无法读取安装包或本机的签名信息，已中止安装。</string>

    <string name="update_ready_title">安装包已就绪</string>
    <string name="update_ready_message">点「安装」后系统会弹出安装界面。若系统提示「禁止安装未知应用」，请先允许本应用安装。</string>
    <string name="update_need_permission_title">需要先允许安装未知应用</string>
    <string name="update_need_permission_message">系统要求先允许本应用安装其它应用。\n\n点「去设置」打开开关，回来后重新点一次「立即升级」即可。</string>

