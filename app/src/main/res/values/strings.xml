<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">CastHub 投屏</string>
    <string name="header_subtitle">多协议投屏接收端 · DLNA / AirPlay</string>

    <!-- ================= 待机页 ================= -->

    <!-- 设备名下方的一句说明：用户要拿着手机在投屏列表里对照这个名字 -->
    <string name="home_device_hint">在手机的投屏列表中选择这个名字</string>

    <string name="home_status_ready">接收服务已就绪，等待设备连接…</string>
    <!--
      部分服务未开启时**直接把是哪一项写进这句话**，而不是在下面再单开一行提示。
      原因：1080p 电视（960×540dp）待机页可滚区只有 ~356dp，"状态卡片 + 芯片 + 引导卡片"
      已经把它占满，再插一块内容就会被裁到只剩几个像素（实测 bounds 高 7px）。
      而主页遥控器滚不动，被裁掉就等于永远看不到。
      两句话说同一件事本来也冗余 —— 合成一句既省高度又没有信息损失。
      「部分服务未开启」这种笼统说法没法告诉用户该开哪一项，所以必须点名。
    -->
    <string name="home_status_partial">「%1$s」未开启，对应投屏将搜不到本机</string>
    <string name="home_status_off">接收服务未开启，手机将无法搜索到本设备</string>

    <string name="home_support_title">支持的投屏方式</string>
    <string name="home_support_none">无可用投屏方式，请到设置中开启</string>

    <string name="home_howto_title">怎么投屏</string>
    <string name="home_howto_body">在手机上打开要播放的 App（如夸克网盘、爱奇艺、腾讯视频），点播放页的「投屏」按钮，在设备列表里选本设备即可。播放、暂停、快进都在手机上操作。</string>

    <string name="home_ip">本机地址</string>
    <string name="home_settings">设置</string>
    <!-- 版本号放主页底部弱色小字：报问题时用户能一眼读到，平时又不干扰 -->
    <string name="home_version">v%1$s</string>

    <!-- ================= 设置页 ================= -->

    <string name="settings_title">设置</string>

    <string name="settings_device_section">设备名称</string>
    <string name="settings_device_desc">手机投屏列表里显示的名字，建议改成好记的，例如「客厅的电视」</string>

    <string name="settings_service_section">接收服务</string>

    <!-- 播放模式：顺序/循环由电视端执行，不依赖手机 App 是否有连播功能 -->
    <string name="settings_playback_section">播放模式</string>
    <!--
      播放模式只留"单曲播放/单曲循环"两种。
      原本还有"顺序播放/列表循环"，真机验证后删掉了：接收端拿不到播放列表
      （手机投一集只发一个 URL，列表在手机 App 里），那两种模式永远不会生效。
      摆一个不生效的选项比没有更糟 —— 用户会当成 bug。
    -->
    <string name="settings_playback_desc">一条播完后是否自动重播。连播与顺序播放请在手机投屏端选择，那里才有播放列表</string>
    <string name="playback_mode_single">单曲播放</string>
    <string name="playback_mode_repeat_one">单曲循环</string>
    <!-- 投屏进行中不允许改模式：队列指针与新模式不一致，播完那一下的行为会难以预期 -->
    <string name="playback_mode_busy">正在投屏，结束投屏后再切换播放模式</string>
    <string name="settings_service_warning">关闭某项后，对应方式的投屏将无法搜索到本设备</string>

    <string name="settings_network_section">网络信息</string>
    <string name="settings_network_hint">每个接收服务各自监听不同的端口，手机端是按设备名搜索、不关心端口</string>
    <string name="settings_log_section">运行日志</string>
    <string name="settings_log_show">展开</string>
    <string name="settings_log_hide">收起</string>
    <string name="settings_log_desc">用于排查问题，正常情况下无需关注</string>

    <string name="settings_about_section">关于</string>
    <!-- 例：CastHub 1.2.1（构建 9） -->
    <string name="settings_version">CastHub %1$s（构建 %2$d）</string>

