    <string name="action_change">切换</string>
    <string name="action_back">返回</string>

    <!-- ================= 投屏中 OSD ================= -->

    <string name="osd_casting">正在投屏</string>
    <string name="osd_from">来自 %1$s</string>

    <!-- 平时显示的遥控器操作提示。退出路径必须写出来：
         不写的话用户不知道返回键能结束投屏，只会觉得被困在全屏里 -->
    <string name="osd_hint_keys">← → 快进 / 快退 10 秒　·　返回键结束投屏</string>
    <string name="osd_seek_forward">⏩ 快进</string>
    <string name="osd_seek_backward">⏪ 快退</string>
    <!-- 例：⏩ 快进 10 秒。具体时间点交给进度条那一行显示，这里不重复 -->
    <string name="osd_seek_feedback">%1$s %2$d 秒</string>
    <string name="osd_cannot_seek">当前内容不支持拖动进度</string>

    <!-- 第一次按返回键的提示。连按两次才真的结束，避免误触停掉投屏 -->
    <string name="osd_press_again_to_exit">再按一次返回键，结束本次投屏</string>
    <!-- 所有模块都报"没有会话"时的兜底提示：明说比让人对着画面连按强 -->
    <string name="osd_cannot_exit">没有可结束的投屏会话，请在手机端停止</string>

